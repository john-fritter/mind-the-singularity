# Postgres. The game lives in its own `mind` schema, so it can share Fritter
# Post's database. Migrations never touch any other schema.
DATABASE_URL=postgresql://mind:password@localhost:5432/fritter_post

# Integration tests drop and recreate the `mind` schema in this database. It
# must be a throwaway database; the tests refuse to run if it equals
# DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/mind_test

# The MCP server (npm run mcp). Loopback only until phase 7.
# MCP_HOST=127.0.0.1
# MCP_PORT=3111
