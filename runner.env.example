# The bot runner's environment (npm run runner). Copy to runner.env, mode 600,
# never committed. Only the runner reads it: the game server and the MCP
# server never hold model keys or the bots' game keys.

# The game's MCP server, if not config/runner.yaml's mcp_url.
# MCP_URL=http://127.0.0.1:3111/mcp

# NanoGPT keys, under the names config/runner.yaml's bots give in
# model_key_env. Bots can share one.
# NANOGPT_KEY=

# Each bot's game API key (npm run key -- add <account>), under the name its
# game_key_env gives.
# MIND_KEY_LANTERN=
